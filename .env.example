# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moviememory?schema=public"
# Tests TRUNCATE tables, so they must use a separate database (created by docker-compose).
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/moviememory_test?schema=public"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Needed when deploying behind a proxy / on a custom host
# AUTH_TRUST_HOST=true

# --- OpenAI (server-side only, never prefixed with NEXT_PUBLIC_) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
